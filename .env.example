# edgestash server
EDGESTASH_PORT=3333
EDGESTASH_PUBLIC_URL=http://localhost:3333
EDGESTASH_DATA_DIR=.data
# Comma separated. Format matters: the SDK reads the store id from the 4th "_" segment.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_local_edgestashdevsecret
EDGESTASH_REDIS_TOKEN=edgestash-dev-token
EDGESTASH_REDIS_READONLY_TOKENS=
EDGESTASH_ADMIN_TOKEN=change-me
# "embedded" or redis://host:6379 to proxy to a real Redis
EDGESTASH_REDIS_BACKEND=embedded
EDGESTASH_SNAPSHOT_INTERVAL_MS=5000
EDGESTASH_MAX_BLOB_BYTES=

# Point the official SDKs at it
VERCEL_BLOB_API_URL=http://localhost:3333/api/blob
UPSTASH_REDIS_REST_URL=http://localhost:3333/redis
UPSTASH_REDIS_REST_TOKEN=edgestash-dev-token
