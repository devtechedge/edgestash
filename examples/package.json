    "ratelimit": "node --env-file=.env.example ratelimit.mjs"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/blob": "^2.8.2"
  }
}
